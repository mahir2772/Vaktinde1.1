<?xml version="1.0" encoding="utf-8"?>
<!-- Takip widget'ı hücresi: özel gün (soluk dolgu + çizgi; vakitler sayılmaz) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <item
        android:width="12dp"
        android:height="12dp"
        android:drawable="@drawable/widget_ic_dash"
        android:gravity="center" />
</layer-list>
