<?xml version="1.0" encoding="utf-8"?>
<!-- Takip widget'ı hücresi: kılındı (nane dolgu + işaret). Hücre çizimleri 24dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00E5A8" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:drawable="@drawable/widget_ic_check"
        android:gravity="center" />
</layer-list>
