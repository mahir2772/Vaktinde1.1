<?xml version="1.0" encoding="utf-8"?>
<!-- Takip widget'ı hücresi: vakti girmedi (soluk çerçeve + saat) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#80FFFFFF" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="15dp"
        android:drawable="@drawable/widget_ic_schedule"
        android:gravity="center" />
</layer-list>
