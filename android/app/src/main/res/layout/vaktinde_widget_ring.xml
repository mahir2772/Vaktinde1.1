<?xml version="1.0" encoding="utf-8"?>
<!-- Vakit halkası (VaktindeWidgetRingProvider): halka önceki vakitten bu yana geçen süre, ortada
     sıradaki vaktin adı, sayaç ve saati (uygulama dilinde). mirrorForRtl yok: halka sağdan sola
     dillerde de saat yönünde dolar. Android 12+ halkayı ve ortadaki metni widget'ın kısa
     kenarına göre büyütür; metinler önizleme / ilk çizim yer tutucusu -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <ProgressBar
        android:id="@+id/ring_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:indeterminate="false"
        android:max="1000"
        android:mirrorForRtl="false"
        android:progress="350"
        android:progressDrawable="@drawable/widget_ring" />

    <!-- Ad ve saat halkanın içindeki dar kirişe sığar (çapın 0,6'sı; uzun ad küçülür, Android 8+) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ring_name"
            android:layout_width="60dp"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/vaktinde_widget_ikindi"
            android:textColor="#00E5A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Varsayılan yazı tipinin rakamları eş genişlikte: sayaç titremez -->
        <Chronometer
            android:id="@+id/chronometer_ring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ring_time"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="16:04"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
