<?xml version="1.0" encoding="utf-8"?>
<!-- Kalıcı bildirim (NotificationUpdater, DecoratedCustomViewStyle). Zemini sistem çizer; cihaza ve
     sürüme göre açık ya da koyu (Android 10+ gece kipi). Yazı renkleri bu yüzden sabit değil:
     sistemin bildirim yazı stilleri (TextAppearance.Material.Notification*: açık zeminde koyu,
     gece kipinde açık yazı). Simge iki zeminde de ≥3:1 okunan nötr gri. Metinleri
     NotificationUpdater yazar; yer tutucu yok (veri yoksa boş) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- SOL BLOK: Konum ve Hicri Tarih -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:tint="#808080" />

            <TextView
                android:id="@+id/notif_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- SAĞ BLOK: Vakit İsmi ve Geri Sayım -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:countDown="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
